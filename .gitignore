# Build output
build/

# IDE
.idea/
.claude/
*.xcodeproj/
*.xcworkspace/

# OS
.DS_Store
Thumbs.db

# Cache
.cache/

# Compiled objects (only in build output, NOT prebuilt libs)
*.o
*.obj
*.plugin

# Prebuilt libraries in cocos2d external/ must be committed
*.a
*.lib
*.so
*.dylib
*.dll
!Library/cocos2d/external/**/prebuilt/**/*.a
!Library/cocos2d/external/**/prebuilt/**/*.lib
!Library/cocos2d/external/**/prebuilt/**/*.so
!Library/cocos2d/external/**/prebuilt/**/*.dylib
!Library/cocos2d/external/**/prebuilt/**/*.dll
